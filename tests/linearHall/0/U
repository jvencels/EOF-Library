FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    InletX
    {
        type fixedValue;
        value uniform (343.0 0 0);   // Mach 1
    }

    OutletX
    {
        type zeroGradient;
    }

    FaradayMinusY
    {
        type noSlip;
    }

    FaradayPlusY
    {
        type noSlip;
    }

    SideWallsZ
    {
        type noSlip;
    }

    defaultFaces
    {
        type noSlip;
    }

}



