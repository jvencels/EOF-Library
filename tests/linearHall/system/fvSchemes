FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default backward;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    div(phi,U)                          Gauss linearUpwind grad(U);
    div(rhoPhi,U)                       Gauss linearUpwind grad(U);
    div(rhoPhi,T)                       Gauss linearUpwind grad(T);
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
    elcond          cellPoint;
    Ux              cellPoint;
    Uy              cellPoint;
    Uz              cellPoint;

    Bx              cellPoint;
    By              cellPoint;
    Bz              cellPoint;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method meshWave;
}



